# Default: local demo authentication and sessionStorage application records.
VITE_USE_MOCK_API=false
# To authenticate with the inspected Laravel application, set false above and
# point this to the HTTP origin that serves C:/xampp/htdocs/internms-api/public.
# Example only: php artisan serve --host=127.0.0.1 --port=8000
VITE_API_BASE_URL=http://127.0.0.1:8001